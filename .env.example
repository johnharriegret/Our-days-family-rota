# Pooled connection, used at runtime.
# On Vercel with the Supabase integration this is already set as POSTGRES_URL -
# nothing to add there. Locally, get it from Supabase: Settings -> Database.
POSTGRES_URL=postgresql://user:password@host:6543/database?pgbouncer=true
# Direct (non-pooled) connection, used only for running migrations.
# On Vercel this is already set as POSTGRES_URL_NON_POOLING.
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/database

# openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# openssl rand -hex 24 -- shown once to whoever creates the first admin account
SETUP_TOKEN=replace-with-a-separate-random-setup-code-at-least-24-characters
