generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Reuses the env vars the Supabase Vercel integration already provisions
  // on the target project (POSTGRES_URL / POSTGRES_URL_NON_POOLING) -
  // deliberately not DATABASE_URL, so connecting this repo to that Vercel
  // project needs zero manual env var setup.
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  ADMIN
  PARENT
  CHILD
}

enum MemberKind {
  PARENT
  CHILD
}

enum ShiftSource {
  MANUAL
  PATTERN_OVERRIDE
}

enum TermType {
  TERM
  HOLIDAY
  INSET
  BANK_HOLIDAY
}

enum EventCategory {
  APPOINTMENT
  ACTIVITY
  HOLIDAY
  OTHER
}

model Household {
  id             String             @id @default(cuid())
  timezone       String             @default("Europe/London")
  weekStartsOn   Int                @default(1)
  createdAt      DateTime           @default(now())
  members        FamilyMember[]
  users          User[]
  patterns       ShiftPattern[]
  shiftTypes     ShiftType[]
  shifts         WorkShift[]
  schools        School[]
  events         Event[]
  leaveGrants    AnnualLeaveGrant[]
  childcareRules ChildcareRule[]
  apiKeys        APIKey[]
  settings       FamilySettings?
}

model User {
  id             String        @id @default(cuid())
  householdId    String
  household      Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  familyMemberId String?       @unique
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id])
  email          String        @unique
  passwordHash   String
  role           Role
  createdAt      DateTime      @default(now())
}

model FamilyMember {
  id          String      @id @default(cuid())
  householdId String
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  kind        MemberKind
  dateOfBirth DateTime?   @db.Date
  schoolId    String?
  school      School?     @relation(fields: [schoolId], references: [id])
  colorToken  String
  icon        String
  archived    Boolean     @default(false)
  requiredWeeklyMinutes Int? // e.g. 2250 for a hard 37.5h/week requirement; null = no fixed requirement
  // Quick-fill defaults for the Month calendar's paint tool (a PARENT only):
  // the colour and canonical start/end time used when someone paints a "Day"
  // or "Night" shift straight onto the calendar, without picking a named
  // shift type. Null = fall back to a sensible computed default (see
  // src/lib/quickShift.ts) rather than leaving the feature unusable before
  // anyone has visited Settings.
  dayColor        String?
  nightColor      String?
  dayStartLocal   String?
  dayEndLocal     String?
  nightStartLocal String?
  nightEndLocal   String?
  user        User?
  patterns    ShiftPattern[]
  shiftTypes  ShiftType[]
  shifts      WorkShift[]
  leaveGrants AnnualLeaveGrant[]

  @@index([householdId])
}

model ShiftPattern {
  id            String       @id @default(cuid())
  householdId   String
  household     Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         FamilyMember @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  anchor        DateTime     @db.Date
  effectiveFrom DateTime     @default(now())
  version       Int          @default(1)
  archivedAt    DateTime?
  blocks        ShiftBlock[]

  @@index([householdId, ownerId])
}

model ShiftBlock {
  id         String       @id @default(cuid())
  patternId  String
  pattern    ShiftPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  order      Int
  kind       String
  count      Int
  startLocal String?
  endLocal   String?

  @@index([patternId])
}

model ShiftType {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       FamilyMember @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  startLocal  String
  endLocal    String
  paidMinutes Int
  color       String
  archived    Boolean      @default(false)
  shifts      WorkShift[]

  @@index([householdId, ownerId])
}

model WorkShift {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       FamilyMember @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  date        DateTime     @db.Date
  shiftTypeId String?
  shiftType   ShiftType?   @relation(fields: [shiftTypeId], references: [id])
  customStart String?
  customEnd   String?
  paidMinutes Int?
  source      ShiftSource
  locked      Boolean      @default(false)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([ownerId, date])
  @@index([householdId, date])
}

model School {
  id          String         @id @default(cuid())
  householdId String
  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  startLocal  String         @default("08:45")
  endLocal    String         @default("15:15")
  terms       SchoolTerm[]
  members     FamilyMember[]

  @@index([householdId])
}

model SchoolTerm {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  type      TermType
  label     String
  // Days of the week this block applies to, 0=Sun..6=Sat (default Mon-Fri).
  // Lets a child attend only some weekdays (e.g. nursery Tue/Wed/Thu).
  weekdays  Int[]    @default([1, 2, 3, 4, 5])

  @@index([schoolId])
}

model Event {
  id          String        @id @default(cuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title       String
  memberIds   String[]
  date        DateTime      @db.Date
  startLocal  String?
  endLocal    String?
  repeatRule  String?
  category    EventCategory @default(OTHER)
  createdAt   DateTime      @default(now())

  @@index([householdId, date])
}

model AnnualLeaveGrant {
  id           String       @id @default(cuid())
  householdId  String
  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        FamilyMember @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  year         Int
  totalMinutes Int
  usedMinutes  Int          @default(0)

  @@unique([ownerId, year])
}

model ChildcareRule {
  id                     String    @id @default(cuid())
  householdId            String
  household              Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  maxUnsupervisedMinutes Int       @default(180)
  appliesWeekends        Boolean   @default(true)
  minSupervisorAge       Int?      @default(13)
  // Below this age, a supervisor-age sibling can never substitute for an
  // actual adult specifically around school drop-off/pick-up (e.g. a
  // toddler who needs to be physically taken to and collected from
  // nursery) - null disables this extra check entirely. Outside the
  // pickupBufferMinutes window either side of school start/end, ordinary
  // sibling supervision still applies as normal.
  strictPickupAge        Int?
  pickupBufferMinutes    Int       @default(30)
  // The time of day from which a school morning needs an actual adult at home,
  // for any child who genuinely attends that day: waking them, breakfast,
  // getting them dressed and doing the school run. Between this time and the
  // school's start time neither an older sibling nor the unattended allowance
  // counts as cover. Stored as "HH:MM" local wall clock; null falls back to
  // 06:00.
  schoolRunMorningFromLocal String? @default("06:00")
  effectiveFrom          DateTime  @default(now())

  @@index([householdId, effectiveFrom])
}

model FamilySettings {
  householdId String    @id
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  data        Json      @default("{}")
}

model APIKey {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  label       String
  hash        String    @unique
  scopes      String[]  @default(["read"])
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([householdId])
}
